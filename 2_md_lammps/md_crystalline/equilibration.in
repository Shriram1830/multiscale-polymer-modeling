# ====================================================================
# LAMMPS Input Script: Polymer Supercell Equilibration
# Description: Reads a parameterized unit cell, replicates it into a 
# supercell, performs energy minimization, and runs NVT followed by 
# NPT equilibration to reach thermodynamic stability.
# ====================================================================

# ==============================================================================
# 1. INITIALIZATION
# ==============================================================================
units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 10.0
kspace_style    pppm 1.0e-4
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2

# ==============================================================================
# 2. SYSTEM DEFINITION & SUPERCELL CREATION
# ==============================================================================
read_data       polymer_unit_cell.data  # INPUT: Insert your parameterized LAMMPS data file here

# ==============================================================================
# 3. SETTINGS & OUTPUTS
# ==============================================================================
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.1       # Explicitly set to 0.1 fs for class2 force fields

thermo          1000
thermo_style    custom step temp press vol density pe ke etotal

dump            1 all custom 5000 dump.polymer_md id type x y z
dump_modify     1 sort id

variable        T equal 300.0

# ==============================================================================
# 4. ENERGY MINIMIZATION
# ==============================================================================
min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000

velocity        all create $T 4928459 rot yes dist gaussian

# ==============================================================================
# 5. NVT EQUILIBRATION (20 ps at 0.1 fs timestep)
# ==============================================================================
fix             1 all nvt temp $T $T 100.0
run             200000
unfix           1

# ==============================================================================
# 6. NPT EQUILIBRATION (80 ps at 0.1 fs timestep)
# ==============================================================================
fix             2 all npt temp $T $T 100.0 iso 1.0 1.0 1000.0
run             800000
unfix           2

# ==============================================================================
# 7. SAVE FINAL STRUCTURE
# ==============================================================================
write_data      final_equilibrated_polymer_1.data
print           "EQUILIBRATION COMPLETE!"
